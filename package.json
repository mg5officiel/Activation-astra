{
  "name": "astra-key",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Générateur de clés d'activation — Astra Key (Ionic + Capacitor)",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "sync": "npm run build && npx cap sync android",
    "android": "npm run sync && npx cap open android"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/clipboard": "^8.0.1",
    "@capacitor/core": "^8.5.2",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/share": "^8.0.2",
    "@fontsource/courier-prime": "^5.3.0",
    "@fontsource/public-sans": "^5.3.0",
    "@ionic/react": "^9.0.4",
    "ionicons": "^8.1.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "@capacitor/filesystem": "^8.0.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "~5.9.3",
    "vite": "^8.3.0"
  }
}
